# ---- Database (Supabase Postgres) -------------------------------------------
# Pooled connection for the app (port 6543, pgbouncer). Used by Prisma at runtime.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (port 5432). Used by `prisma migrate` only.
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ---- Supabase (owner auth + RLS) --------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT.supabase.co"
# Anon key is public by design — RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
# Service role bypasses RLS entirely. Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ---- Admin auth (NextAuth) ---------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ---- Photo storage (Cloudflare R2) ------------------------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="site-diary"
# Public base URL for serving photos (custom domain or r2.dev bucket URL).
R2_PUBLIC_BASE_URL="https://photos.example.com"

# ---- Email (Resend) ----------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="updates@example.com"

# ---- Owner sign-in -----------------------------------------------------------
# Set to "true" only once an SMS provider is configured in Supabase Auth
# (Authentication > Providers > Phone). Until then owners sign in by email and
# the mobile option is hidden rather than offered and broken.
NEXT_PUBLIC_SMS_ENABLED="false"

# ---- Scheduled jobs ----------------------------------------------------------
# Shared secret so only the scheduler can trigger digest/nudge endpoints.
CRON_SECRET=""
