# ---- Database (Supabase Postgres) -------------------------------------------
# Pooled connection for the app (port 6543, pgbouncer). Used by Prisma at runtime.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (port 5432). Used by `prisma migrate` only.
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ---- Public base URL ---------------------------------------------------------
# Every owner link and every email link is built from this. Required.
NEXT_PUBLIC_SITE_URL="https://example.com"

# NOTE: Supabase is used purely as a Postgres host. Owners hold a house link
# rather than an account, nothing in the browser talks to Supabase, and there
# are no API keys to configure.

# ---- Admin auth (NextAuth) ---------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ---- Photo storage (Cloudflare R2) ------------------------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# Private bucket: house photos and documents. No public access — served only
# through short-lived signed URLs.
R2_BUCKET="site-diary"
# Separate PUBLIC bucket for marketing-site imagery uploaded through the admin.
# These belong on the public website, so they must not sit behind signed URLs.
R2_PUBLIC_BUCKET="site-diary-public"
# Public base URL for that public bucket (custom domain or r2.dev URL).
R2_PUBLIC_BASE_URL="https://images.example.com"

# ---- Email -------------------------------------------------------------------
# Two options. Use Gmail if there is no business domain yet.
#
# OPTION A — Gmail (no domain needed, recommended to start)
#   Updates arrive from his real address, which clients already recognise, and
#   replies come straight back to him. Limit is 500 recipients/day; 25 houses
#   is about 50 per round.
#   1. Turn on 2-Step Verification on the Google account.
#   2. myaccount.google.com/apppasswords -> create one -> paste it below.
GMAIL_USER="hisname@gmail.com"
GMAIL_APP_PASSWORD=""
# How the sender name appears in their inbox.
EMAIL_FROM_NAME="Dave at Smith Building"

# OPTION B — Resend (needs a domain you own and have verified)
#   Takes precedence over Gmail when both are set. Without a verified domain
#   Resend will only deliver to the account owner's own address, so it is no
#   use for real clients until the DNS records are in.
RESEND_API_KEY=""
EMAIL_FROM=""

# ---- Voice write-up (optional) ----------------------------------------------
# Turns his spoken site notes into an owner-facing update. Without it the
# dictation box still works — he just writes the message himself.
# Get a key at console.anthropic.com. Costs a fraction of a cent per update.
ANTHROPIC_API_KEY=""

# ---- Admin -------------------------------------------------------------------
# Required by the seed. Generate with: openssl rand -base64 24
ADMIN_PASSWORD=""

# ---- Scheduled jobs ----------------------------------------------------------
# Shared secret so only the scheduler can trigger digest/nudge endpoints.
CRON_SECRET=""
