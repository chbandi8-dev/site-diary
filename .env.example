# ---- Database (Supabase Postgres) -------------------------------------------
# Pooled connection for the app (port 6543, pgbouncer). Used by Prisma at runtime.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (port 5432). Used by `prisma migrate` only.
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ---- Public base URL ---------------------------------------------------------
# Every owner link and every email link is built from this. Required.
NEXT_PUBLIC_SITE_URL="https://example.com"

# NOTE: Supabase is used purely as a Postgres host. Owners hold a house link
# rather than an account, nothing in the browser talks to Supabase, and there
# are no API keys to configure.

# ---- Admin auth (NextAuth) ---------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ---- Photo storage (Cloudflare R2) ------------------------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# Private bucket: house photos and documents. No public access — served only
# through short-lived signed URLs.
R2_BUCKET="site-diary"
# Separate PUBLIC bucket for marketing-site imagery uploaded through the admin.
# These belong on the public website, so they must not sit behind signed URLs.
R2_PUBLIC_BUCKET="site-diary-public"
# Public base URL for that public bucket (custom domain or r2.dev URL).
R2_PUBLIC_BASE_URL="https://images.example.com"

# ---- Email (Resend) ----------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="updates@example.com"

# ---- Admin -------------------------------------------------------------------
# Required by the seed. Generate with: openssl rand -base64 24
ADMIN_PASSWORD=""

# ---- Scheduled jobs ----------------------------------------------------------
# Shared secret so only the scheduler can trigger digest/nudge endpoints.
CRON_SECRET=""
